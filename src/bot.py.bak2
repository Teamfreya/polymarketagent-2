# --- User Provided Helpers ---
SERIES_SLUG = "btc-up-or-down-15m"

def get_current_btc_15m_event():
    now = datetime.now(timezone.utc)
    
    # Calculate the start of the current 15-minute window
    # Floor minutes to nearest 15
    floor_min = (now.minute // 15) * 15
    start_dt = now.replace(minute=floor_min, second=0, microsecond=0)
    
    # Timestamp is int seconds
    start_ts = int(start_dt.timestamp())
    
    # Construct Slug
    # Pattern: btc-updown-15m-{timestamp}
    # Example: btc-updown-15m-1765565100
    slug = f"btc-updown-15m-{start_ts}"
    
    print(f"DEBUG: derived slug {slug} for time {start_dt}")

    # Fetch directly
    try:
        resp = requests.get(
            "https://gamma-api.polymarket.com/events",
            params={"slug": slug},
            timeout=10,
        )
        resp.raise_for_status()
        events = resp.json()
    except Exception as e:
        print(f"Error fetching exact gamma event: {e}")
        return None

    if events:
        print(f"DEBUG: Found precise match for {slug}")
        return events[0]
        
    print(f"DEBUG: Precise slug {slug} not found. Searching next window...")
    return None

def get_live_quotes_from_gamma(event):
    m = event["markets"][0]
    # Handle clobTokenIds parsing safely
    try:
        tokens = json.loads(m["clobTokenIds"]) if isinstance(m["clobTokenIds"], str) else m["clobTokenIds"]
        outcomes = json.loads(m["outcomes"]) if isinstance(m["outcomes"], str) else m["outcomes"]
    except:
        tokens = []
        outcomes = []
        
    return {
        "event_id": event["id"],
        "market_id": m["id"],
        "slug": event["slug"],
        "start": event.get("eventStartTime") or event.get("startTime"),
        "end": event["endDate"],
        "bestBid": float(m.get("bestBid", 0) or 0),
        "bestAsk": float(m.get("bestAsk", 0) or 0),
        "spread": float(m.get("spread", 0) or 0),
        "tokens": tokens,   # [UpToken, DownToken]
        "outcomes": outcomes,     # ["Up","Down"]
        "groupItemTitle": m.get("groupItemTitle")
    }
# -----------------------------

class Bot:
    def __init__(self):
        self.state = BotState()
        self.state.load()
        
        self.btc_source = BinancePriceSource()
        self.poly_fetcher = PolymarketFetcher()
        self.poly_fetcher = PolymarketFetcher()
        self.strategy = Strategy()
        self.time_offset = None
        self.last_check_time = 0
        self.last_outcome_check = 0  # Track when we last checked outcomes
        
        try:
            self.client = PolyClient()
        except Exception as e:
            print(f"Failed to init PolyClient: {e}")
            sys.exit(1)

        self.last_run_time = 0
        self.active_event_id = None
        self.active_strike = None
        
        # Multi-layer duplicate prevention
        import threading
        
        # Layer 1: Cycle-level mutex (prevents overlapping run_cycle_full calls)
        self._cycle_lock = threading.Lock()
        
        # Layer 2: Event-level reservation (atomic in-flight tracking)
        self._trade_lock = threading.Lock()  # Protects _in_flight and _attempted_keys
        self._in_flight = set()  # Event IDs currently being processed
        
        # Layer 3: Idempotency tracking (permanent record of attempts)
        self._attempted_keys = set()  # Keys: "event_id:direction"

    def sync_clock(self):
        try:
            print("Syncing clock with Coinbase API...")
            resp = requests.get("https://api.coinbase.com/v2/time", timeout=5)
            data = resp.json()['data']
            # strptime handling Z
            # Python < 3.11 fromisoformat might not handle Z easily? 
            # replace Z with +00:00 is safer
            iso = data['iso'].replace('Z', '+00:00')
            server_time = datetime.fromisoformat(iso)
            
            system_time = datetime.now(timezone.utc)
            self.time_offset = server_time - system_time
            print(f"Time Sync: Offset is {self.time_offset}")
        except Exception as e:
            print(f"Time Sync Failed: {e}. Defaulting to 0 offset.")
            self.time_offset = timedelta(0)

    def try_reserve_event(self, event_id: str) -> bool:
        """
        Atomically check and reserve event for processing.
        Returns False if event is already in-flight.
        """
        with self._trade_lock:
            if event_id in self._in_flight:
                return False
            self._in_flight.add(event_id)
            return True
    
    def release_event(self, event_id: str):
        """Release event reservation (e.g., on order failure before submission)."""
        with self._trade_lock:
            self._in_flight.discard(event_id)
    
    def try_mark_attempt(self, event_id: str, direction: str) -> bool:
        """
        Atomically check and mark (event_id:direction) as attempted.
        Returns False if this combination was already attempted.
        This provides idempotency - once attempted, never retry same direction.
        """
        key = f"{event_id}:{direction}"
        with self._trade_lock:
            if key in self._attempted_keys:
                return False
            self._attempted_keys.add(key)
            return True


    def parse_strike_price(self, title: str) -> float:
        # Example: "BTC > 98500.55 on Dec..."
        # Regex to find number after "BTC >" or "Bitcoin >"
        # Handles $ sign and commas
        match = re.search(r'(?:BTC|Bitcoin)\s*>\s*\$?([\d,]+\.?\d*)', title)
        if match:
            s = match.group(1).replace(',', '')
            return float(s)
        return 0.0

    def get_market_prices(self, clob_id: str) -> dict:
        # Fetch orderbook or ticker
        # We need "Yes" and "No" prices.
        # Use get_market from client?
        m = self.client.get_market(clob_id)
        # m structure depends on library. 
        # Usually has 'rewards'? Or we call get_ticker?
        # Let's try to get mid price or best ask.
        # For simplicity, we want Best Ask (Buy Price).
        # We place LIMIT order at best ask.
        # But we need "Price Up" and "Price Down".
        
        # Actually we can get the ticker via request to CLOB API if library is tricky
        # But `get_market` returns market info.
        # We need the Orderbook to know the Ask.
        return m

    def run_cycle(self):
        # 0. Check trade outcomes every 5 minutes
        current_time = time.time()
        if current_time - self.last_outcome_check > 300:  # 5 minutes
            self.check_trade_outcomes()
            self.last_outcome_check = current_time
        
        # 1. Update BTC Price
        btc_price = self.btc_source.fetch_price()
        if btc_price is None:
            print("Skipping cycle: No BTC Price")
            return

        btc_90s = self.btc_source.get_price_90s_ago()
        
        # 2. Check Safety Locks
        if self.state.check_safety_locks():
            print("Safety Lock Active. Sleeping.")
            return

        # 3. Consume Skip if active
        if self.state.skipped_signals_remaining > 0:
            print(f"Streak Protection Active. Skipping signals. Remaining: {self.state.skipped_signals_remaining}")
            # We must still validate if a signal WOULD have happened to decrement the counter?
            # User: "Count the next 5 valid entry signals ... as skipped"
            # So we must proceed to finding market and validating signal, then NOT trade, and decrement.
            pass

        # 4. Find Market
        event = self.poly_fetcher.find_current_market()
        if not event:
            print("No matching active 15m BTC market found.")
            return

        # Extract Details
        title = event.get('title', '')
        strike_price = self.parse_strike_price(title)
        if strike_price == 0:
            print(f"Could not parse strike from: {title}")
            return
            
        # Time remaining
        end_date = event.get('endDate') # ISO string
        # Calculate minutes remaining
        # ...
        
        # Determine YES/NO tokens
        markets = event.get('markets', [])
        if not markets:
            print("Event has no markets")
            return
            
        market_data = markets[0] # Assume 1 market pair
        clob_id = market_data.get('conditionId') # Or tokenIds?
        # Actually ClobClient uses Token IDs for orders.
        # market_data should have 'clobTokenIds' or similar.
        # Gamma output might differ.
        # Let's assume we can get token IDs.
        
        # Need accurate Minutes Remaining
        # ...
        
        # 5. Check Strategy (Implementation detailed in run method)
        pass 

    def run(self):
        print("Bot Started (Minute-by-Minute Mode).")
        while True:
            try:
                self.run_cycle_full()
            except Exception as e:
                print(f"Error in cycle: {e}")
            
            # Faster Scan: Sleep 15s
            sleep_sec = 15
            
            print(f"Sleeping {sleep_sec}s...")
            time.sleep(sleep_sec)

    def log_activity(self, row_data):
        file_exists = os.path.isfile("activity_log.csv")
        with open("activity_log.csv", "a") as f:
            headers = ["Timestamp", "EventID", "MinutesLeft", "BTC_Price", "Strike", "Diff", "Momentum", "Action", "Details", "Balance"]
            if not file_exists:
                f.write(",".join(headers) + "\n")
            
            # map row_data to headers
            # default to empty string if missing
            timestamp = datetime.utcnow().strftime("%Y-%m-%d %H:%M:%S")
            line = [
                timestamp,
                str(row_data.get("EventID", "")),
                f"{row_data.get('MinutesLeft', 0):.2f}",
                f"{row_data.get('BTC_Price', 0):.2f}",
                f"{row_data.get('Strike', 0):.2f}",
                f"{row_data.get('Diff', 0):.2f}",
                f"{row_data.get('Momentum', 0):.2f}",
                row_data.get("Action", ""),
                row_data.get("Details", "").replace(",", ";"), # Escape commas
                str(row_data.get("Balance", ""))
            ]
            f.write(",".join(line) + "\n")




    def run_cycle_full(self):
        # Generate unique cycle ID for debugging
        import uuid
        cycle_id = str(uuid.uuid4())[:8]
        
        # Layer 1: Cycle-level mutex (non-blocking)
        # Prevents overlapping run_cycle_full() calls
        if not self._cycle_lock.acquire(blocking=False):
            print(f"[{cycle_id}] SKIP: Cycle overlap detected, another cycle is running")
            return
        
        try:
            # Full logic implementation
            
            # 1. BTC Data
            btc_price = self.btc_source.fetch_price()
            if not btc_price: return
        
            # 2. State Check
            if self.state.check_safety_locks(): 
                return

            if self.time_offset is None:
                 self.sync_clock()
            
            # Adjust 'now'
            now = datetime.now(timezone.utc) + self.time_offset
        
        # 3. Market Discovery (NEW LOGIC)
        event = get_current_btc_15m_event()
        if not event:
            # print("Searching for market... (No match found)")
            return

        # 4. Get Reliable Quotes (Gamma)
        quotes = get_live_quotes_from_gamma(event)
        
        event_id = quotes['event_id']
        title = event['title']
        minutes_remaining = (datetime.fromisoformat(quotes['end'].replace("Z", "+00:00")) - now).total_seconds() / 60
        
        # Check pre-calculated processed constraints
        # MOVED TO LATER to allow "Watching" (logging price data) without trading
        # if event_id in self.state.processed_events:
        #      print(f"DEBUG: Event {event_id} already processed. Skipping.")
        #      return # Already handled
             
        print(f"DEBUG: Processing {event_id} | {minutes_remaining:.2f}m left")
        
        # Parse Strike from quotes or event
        strike_source = quotes.get('groupItemTitle') or title
        strike = self.parse_strike_price(strike_source)
        
        if not strike:
             # Fallback: Try to use Event Start Time price
             start_time_iso = quotes.get('start')
             if start_time_iso:
                 st = parser.isoparse(start_time_iso)
                 if st.tzinfo is None: st = st.replace(tzinfo=timezone.utc)
                 
                 if now < st:
                     # Too early, strike not yet determined
                     print(f"Event starts at {start_time_iso} (Future). Waiting for Strike determination.")
                     self.log_activity({
                        "EventID": event_id,
                        "MinutesLeft": minutes_remaining,
                        "BTC_Price": btc_price,
                        "Strike": 0,
                        "Diff": 0,
                        "Momentum": 0,
                        "Action": "WAITING",
                        "Details": "Pre-Market: Waiting for Strike"
                     })
                     return
                     
                 # print(f"DEBUG: Parse failed. Fetching historical price at {start_time_iso}...")
        # Caching Logic for Strike
        event_id_str = str(event_id)
        
        if self.active_event_id == event_id_str and self.active_strike:
            # Use cached strike if available (saves API calls or parsing issues)
            # Use the cached value only if we failed to parse it fresh, OR just trust cache?
            # Trust cache if fresh parse failed?
            if not strike:
                strike = self.active_strike
        else:
            # New event or no cache
            if strike:
                # We parsed it successfully, update cache
                self.active_event_id = event_id_str
                self.active_strike = strike
            else:
                # Failed to parse, try historical fallback
                start_iso = quotes.get('start')
                if start_iso:
                    # Fetch historical
                    print(f"DEBUG: Fetching historical strike for {start_iso}")
                    h_strike = self.btc_source.get_historical_price(start_iso)
                    if h_strike:
                        strike = h_strike
                        self.active_event_id = event_id_str
                        self.active_strike = strike

        if not strike:
             # print(f"Failed to parse strike from: {strike_source} and failed historical fetch.")
             return

        # Need 90s BTC
        btc_90s = self.btc_source.get_price_90s_ago()
        
        # Check if bot has any open positions for THIS event
        has_pos = any(t['status'] == 'OPEN' and t['event_id'] == event_id for t in self.state.trades)

        # 5. Signal Check
        # Parse Strike
        # 5. Check Entry Signal
        # Prepare Context & Signals
        
        # 1. Fetch Token-Specific Prices (UI Parity)
        clob_ids = quotes['tokens']
        # print(f"DEBUG: Initializing Price Fetch for Tokens: {clob_ids}")
        
        def get_prices(tid):
            try:
                # Use side="BUY" for BID (Highest someone will pay)
                # Use side="SELL" for ASK (Lowest someone will sell)
                b_obj = self.client.client.get_price(tid, side="BUY")
                a_obj = self.client.client.get_price(tid, side="SELL")
                
                bid = float(b_obj['price']) if b_obj and 'price' in b_obj else 0.0
                ask = float(a_obj['price']) if a_obj and 'price' in a_obj else 0.0
                return bid, ask
            except Exception as e:
                # print(f"DEBUG: Price Fetch Error for {tid}: {e}")
                return 0.0, 0.0

        if len(clob_ids) >= 2:
            up_bid, up_ask = get_prices(clob_ids[0])
            dn_bid, dn_ask = get_prices(clob_ids[1])
            price_context = f" [UP bid/ask: {up_bid}/{up_ask} | DOWN bid/ask: {dn_bid}/{dn_ask}]"
        else:
             price_context = " [Price Error]"
        
        # Ensure clob_ids are ready for execution phase
        clob_ids = quotes['tokens']

        # 2. Check Signals
        # Fetch Volatility
        volatility = self.btc_source.get_btc_volatility()
        print(f"DEBUG: BTC Volatility (Median 1h): ${volatility:.2f}")

        should_trade, direction, reason = self.strategy.check_entry(
            btc_price=btc_price,
            btc_price_90s_ago=btc_90s,
            strike_price=strike,
            minutes_remaining=minutes_remaining,
            event_id=event_id,
            has_open_position=has_pos,
            volatility=volatility
        )
        
        # 3. Calculate metrics for logging
        diff = btc_price - strike
        momentum = (btc_price - btc_90s) if btc_90s else 0.0
        
        # Logic:
        # Get Balance (RPC)
        bal = self.client.get_usdc_balance()
        
        if not should_trade:
            # Log all evaluations for complete 15-minute data tracking
            self.log_activity({
                "EventID": event_id,
                "MinutesLeft": minutes_remaining,
                "BTC_Price": btc_price,
                "Strike": strike,
                "Diff": diff,
                "Momentum": momentum,
                "Action": "SKIP",
                "Details": reason + price_context,
                "Balance": bal
            })
            print(f"Skipping: {reason} {price_context}")
            self.check_open_positions() # Check resolutions while waiting
            return

        # Valid Signal!
        
        # 4. Check if we already traded THIS event (Watching Mode)
        # This allows us to log "WATCH" entries for valid signals on already-traded events
        if event_id in self.state.processed_events:
             bal = self.client.get_usdc_balance() # Refresh balance for log
             self.log_activity({
                "EventID": event_id,
                "MinutesLeft": minutes_remaining,
                "BTC_Price": btc_price,
                "Strike": strike,
                "Diff": diff,
                "Momentum": momentum,
                "Action": "WATCH",
                "Details": "Already Traded - Monitoring" + price_context,
                "Balance": bal
             })
             print(f"Watching (Already Traded): {price_context} | BTC: {btc_price} | Strike: {strike}")
             return
        
        # Layer 2: Event Reservation Gate
        # Atomically check if event is already being processed
        if not self.try_reserve_event(event_id):
            print(f"[{cycle_id}] SKIP: Event {event_id} already in-flight")
            return
        
        # Layer 3: Idempotency Gate
        # Check if we've already attempted this (event_id, direction) combination
        if not self.try_mark_attempt(event_id, direction):
            print(f"[{cycle_id}] SKIP: Already attempted {event_id}:{direction}")
            self.release_event(event_id)  # Release reservation since we're not proceeding
            return
        
        # Both gates passed - proceed with trade execution
        print(f"[{cycle_id}] Gates passed for {event_id}:{direction}, proceeding to order placement")
        
        try:
            # 7. Handle Streak Skipping
            if not self.state.can_trade(event_id):
                 msg = f"Risk limit hit (Daily: {self.state.daily_pnl}, Streak: {self.state.consecutive_losses})"
                 self.log_activity({
                    "EventID": event_id,
                    "MinutesLeft": minutes_remaining,
                    "BTC_Price": btc_price,
                    "Strike": strike,
                    "Diff": diff,
                    "Momentum": momentum,
                    "Action": "PROTECT",
                    "Details": msg + price_context,
                    "Balance": bal
                })
                 self.state.consume_skip()
                 self.state.processed_events.append(event_id)
                 self.state.save()
                 
                 # Cleanup: release event reservation
                 self.release_event(event_id)
                 return

            # 8. Execute Trade
            print(f"[{cycle_id}] EXECUTING {direction} Trade on {title}")
            self.log_activity({
                    "EventID": event_id,
                    "MinutesLeft": minutes_remaining,
                    "BTC_Price": btc_price,
                    "Strike": strike,
                    "Diff": diff,
                    "Momentum": momentum,
                    "Action": "TRADE_EXEC",
                    "Details": f"[{cycle_id}] Placing {direction} Order" + price_context
                })
            
            # Identify Tokens
            if not clob_ids:
                 print(f"[{cycle_id}] Error: No Token IDs found")
                 self.release_event(event_id)
                 return

            token_id = clob_ids[0] if direction == "UP" else clob_ids[1]
            
            # Get Best Ask
            try:
                ob = self.client.client.get_order_book(token_id)
                if not ob.asks:
                    print(f"[{cycle_id}] No asks available")
                    self.release_event(event_id)
                    return
                best_ask = float(ob.asks[0].price)
                best_bid = float(ob.bids[0].price) if ob.bids else 0.0
            except Exception as e:
                print(f"[{cycle_id}] Error fetching orderbook: {e}")
                self.release_event(event_id)
                return

            limit_price = best_ask 
            spread = best_ask - best_bid
            
            # Fixed 25 shares per trade
            if limit_price <= 0: 
                self.release_event(event_id)
                return
                
            size = 25.0  # Fixed share count
            size = round(size, 1) 
            
            print(f"Placing Order: {direction} | Price: {limit_price} | Size: {size}")
            
            # Calculate potential outcome
            potential_profit_per_share = 1.0 - limit_price
            max_profit = potential_profit_per_share * size
            roi_pct = (potential_profit_per_share / limit_price) * 100 if limit_price > 0 else 0
            
            print(f"[{cycle_id}] Placing Order: {direction} | Price: ${limit_price} | Size: {size}")
            print(f"[{cycle_id}] Stats: Return +${potential_profit_per_share:.2f}/share | Total Max Profit: +${max_profit:.2f} | ROI: {roi_pct:.1f}%")

            self.log_activity({
                    "EventID": event_id,
                    "MinutesLeft": minutes_remaining,
                    "BTC_Price": btc_price,
                    "Strike": strike,
                    "Diff": diff,
                    "Momentum": momentum,
                    "Action": "ORDER_PREP",
                    "Details": f"[{cycle_id}] Price: ${limit_price} | ROI: {roi_pct:.0f}% | MaxProfit: ${max_profit:.2f}" + price_context,
                    "Balance": bal
                })
            
            # DRY RUN Handling
            if os.getenv("DRY_RUN", "True").lower() in ("true", "1", "yes"):
                print(f"[{cycle_id}] [DRY RUN] Order NOT placed")
                self.release_event(event_id)
                return

            try:
                print(f"[{cycle_id}] DEBUG: sending order {token_id} {limit_price} {size}")
                resp = self.client.place_limit_order(token_id, "BUY", limit_price, size)
                print(f"DEBUG: Order Response: {resp}")
            except Exception as e:
                print(f"CRITICAL: Order Placement Failed: {e}")
                self.log_activity({
                    "EventID": event_id,
                    "MinutesLeft": minutes_remaining,
                    "BTC_Price": btc_price,
                    "Strike": strike,
                    "Diff": diff,
                    "Momentum": momentum,
                    "Action": "ORDER_ERROR",
                    "Details": str(e)
                })
                self.release_event(event_id)
                return
            
            if resp and resp.get('orderID'):
                print(f"Order Placed: {resp['orderID']}")
                self.log_activity({
                    "EventID": event_id,
                    "MinutesLeft": minutes_remaining,
                    "BTC_Price": btc_price,
                    "Strike": strike,
                    "Diff": diff,
                    "Momentum": momentum,
                    "Action": "ORDER_SENT",
                    "Details": f"ID: {resp['orderID']}",
                    "Balance": bal
                })
                
                # Mark as PROCESSED PERMANENTLY
                self.state.processed_events.append(event_id)
                self.state.save()
                
                # Keep event reserved (don't release) - prevents duplicate attempts
                # Event stays in _in_flight until market resolves
                
                # Check confirmation
                try:
                    status = self.client.get_order_status(resp['orderID'])
                    print(f"DEBUG: Order Status: {status}")
                except Exception as e:
                    print(f"Error fetching order status: {e}")
                    status = None

                # Check if order was matched/filled
                order_status = status.get('status') if status else None
                
                if order_status != 'MATCHED': 
                     print(f"Order status {order_status}. Cancelling...")
                     try:
                        self.client.cancel_order(resp['orderID'])
                     except: pass
                     return
                
                # Filled
                trade_record = {
                    'event_id': event_id,
                    'token_id': token_id, 
                    'direction': direction,
                    'entry_price': limit_price,
                    'size': size,
                    'timestamp': datetime.utcnow().isoformat(),
                    'status': 'OPEN'
                }
                self.state.record_trade(trade_record)
            else:
                print(f"CRITICAL: Order Placement Failed. Response: {resp}")
                self.log_activity({
                    "EventID": event_id,
                    "MinutesLeft": minutes_remaining,
                    "BTC_Price": btc_price,
                    "Strike": strike,
                    "Diff": diff,
                    "Momentum": momentum,
                    "Action": "ORDER_FAIL",
                    "Details": f"Resp: {str(resp)}",
                    "Balance": bal
                })
                self.release_event(event_id)
                return
                
        except Exception as e:
            print(f"[{cycle_id}] CRITICAL: Unexpected error in trade execution: {e}")
            self.release_event(event_id)
            return
        finally:
            # Release cycle lock
            self._cycle_lock.release()

    def check_open_positions(self):
        # Scan OPEN trades and check if resolved
        for trade in self.state.trades:
            if trade['status'] == 'OPEN':
                # Check status
                # We can use Gamma API to check event status
                # or client.get_market
                # Gamma is easier to bulk check? Or just one by one.
                # Since we only have 1 at a time usually, one by one is fine.
                
                # Fetch event details
                try:
                    # We assume we can get event by ID from event_id in trade
                    # Gamma lookup
                    url = f"https://gamma-api.polymarket.com/events/{trade['event_id']}"
                    resp = requests.get(url, timeout=5)
                    if resp.status_code == 200:
                        event = resp.json()
                        if event.get('closed'):
                            # Resolved!
                            self.resolve_trade(trade, event)
                except Exception as e:
                    print(f"Error checking position {trade['event_id']}: {e}")

    def resolve_trade(self, trade, event):
        print(f"Resolving trade for {trade['event_id']}")
        
        # We need to find if our token won.
        # Check markets in event
        markets = event.get('markets', [])
        if not markets: return

        # Assuming the first market is the one we traded
        market = markets[0]
        
        # Check for 'winner' field in market outcomes?
        # Or 'question' might indicate resolution.
        # But commonly, we check if the market is closed and what the final value is.
        # If we use indices for outcomes:
        # 0 = Up, 1 = Down (based on our assume order in clobTokenIds).
        # We need to be sure.
        
        # If market['state'] == 'RESOLVED' or similar?
        # Gamma typically provides `market['outcomes']` like ["Up", "Down"]
        # And `market['winner']` might be "Up" or "Down".
        
        winner = market.get('winner') # e.g. "Up" or "Down"
        if not winner:
            # Maybe it's closed but winner not populated yet?
            return

        print(f"Market Winner: {winner}")
        
        # Did we win?
        # Our direction: UP (Yes), DOWN (No)
        # Winner: "Yes", "No" (typically)
        
        my_outcome = "Yes" if trade['direction'] == "UP" else "No"
        won = (my_outcome.lower() == winner.lower())
        
        # Calc PnL
        size_shares = trade['size']
        entry_price = trade['entry_price']
        cost_basis = size_shares * entry_price # Should be approx 10
        
        payout_per_share = 1.0 if won else 0.0
        final_value = size_shares * payout_per_share
        
        pnl = final_value - cost_basis
        
        print(f"Trade Resolved. Won: {won}. PnL: ${pnl:.2f}")
        
        # Update State
        self.state.update_pnl(pnl, won)
        
        # Mark trade as CLOSED
        trade['status'] = 'CLOSED'
        trade['exit_price'] = payout_per_share
        trade['pnl'] = pnl
        trade['resolved_outcome'] = winner
        
        self.state.save()
    
    def check_trade_outcomes(self):
        """
        Check if any open trades have resolved and log outcomes
        """
        for trade in self.state.trades:
            # Skip if already closed
            if trade.get('status') != 'OPEN':
                continue
            
            event_id = trade.get('event_id')
            direction = trade.get('direction')
            
            try:
                # Check if market has resolved
                url = f"https://gamma-api.polymarket.com/events/{event_id}"
                resp = requests.get(url, timeout=5)
                event = resp.json()
                
                # Check if closed
                if not event.get('closed', False):
                    continue
                
                # Get outcome
                markets = event.get('markets', [])
                if not markets:
                    continue
                
                market = markets[0]
                outcome_prices = market.get('outcomePrices', [])
                
                if len(outcome_prices) >= 2:
                    up_price = float(outcome_prices[0])
                    down_price = float(outcome_prices[1])
                    
                    # Determine winner
                    if up_price > 0.99:
                        outcome = 'UP'
                    elif down_price > 0.99:
                        outcome = 'DOWN'
                    else:
                        continue  # Not clearly resolved yet
                    
                    # Check if we won
                    won = (direction == outcome)
                    result = "WIN" if won else "LOSS"
                    
                    # Calculate PnL
                    size = trade.get('size', 0)
                    entry_price = trade.get('entry_price', 0)
                    cost = size * entry_price
                    
                    if won:
                        payout = size * 1.0  # Each share pays $1
                        pnl = payout - cost
                    else:
                        pnl = -cost
                    
                    # Log outcome
                    self.log_activity({
                        "EventID": event_id,
                        "MinutesLeft": "",
                        "BTC_Price": "",
                        "Strike": "",
                        "Diff": "",
                        "Momentum": "",
                        "Action": "TRADE_RESULT",
                        "Details": f"{result}: {direction} trade, market resolved {outcome}, PnL: ${pnl:.2f}"
                    })
                    
                    print(f"✅ Trade {result}: Event {event_id}, {direction} → {outcome}, PnL: ${pnl:.2f}")
                    
                    # Update state
                    self.state.update_pnl(pnl, won)
                    
                    # Mark trade as closed
                    trade['status'] = 'CLOSED'
                    trade['pnl'] = pnl
                    trade['resolved_outcome'] = outcome
                    self.state.save()
                    
            except Exception as e:
                print(f"Error checking outcome for {event_id}: {e}")
